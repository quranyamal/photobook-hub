# Database
DATABASE_URL="postgresql://photobook:photobook@localhost:5432/photobook"

# App
NODE_ENV="development"

# NextAuth — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Logging
LOG_LEVEL="info"

# File uploads
UPLOAD_DIR=".uploads"

# OpenTelemetry
OTEL_SERVICE_NAME="photobook-hub"
OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# Admin seed — used by prisma/seed.ts and pnpm db:seed
ADMIN_EMAIL="admin@photobookhub.com"
ADMIN_PASSWORD="Admin123!"
